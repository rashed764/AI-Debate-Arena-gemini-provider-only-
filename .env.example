# GEMINI_API_KEY: Primary or default fallback for Gemini AI API calls.
# Users configure separate keys via Settings -> AI API Configuration in the web UI.
GEMINI_API_KEY=""

# Optional persona-specific fallback keys (UI settings take precedence):
GEMINI_API_KEY_ATHEIST=""
GEMINI_API_KEY_BELIEVER=""

# Default model identifiers:
GEMINI_MODEL_DEFAULT="gemini-3.8-flash"
GEMINI_TTS_MODEL_DEFAULT="gemini-3.8-flash-lite-tts"

# Security & Encryption:
# 32-byte hex or base64 key for AES-256-GCM encryption of stored API keys (auto-generated if empty)
APP_ENCRYPTION_KEY=""
ADMIN_PASSWORD="admin"
SESSION_SECRET="arena_secure_session_secret_key"

# APP_URL: The URL where this applet is hosted.
APP_URL=""
